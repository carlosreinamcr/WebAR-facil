;; Exact ORB Hamming top-2 matcher. Original code, MIT.
(module
  (memory (export "memory") 1 256)
  (func (export "match") (param $q i32) (param $qn i32) (param $t i32) (param $tn i32) (param $out i32)
    (local $i i32) (local $j i32) (local $p i32) (local $qp i32) (local $op i32)
    (local $best i32) (local $second i32) (local $index i32) (local $d i32)
    (local $q0 i32) (local $q1 i32) (local $q2 i32) (local $q3 i32) (local $q4 i32) (local $q5 i32) (local $q6 i32) (local $q7 i32)
    (block $done (loop $queries
      (br_if $done (i32.ge_u (local.get $i) (local.get $qn)))
      (local.set $qp (i32.add (local.get $q) (i32.shl (local.get $i) (i32.const 5))))
      (local.set $q0 (i32.load offset=0 (local.get $qp)))
      (local.set $q1 (i32.load offset=4 (local.get $qp)))
      (local.set $q2 (i32.load offset=8 (local.get $qp)))
      (local.set $q3 (i32.load offset=12 (local.get $qp)))
      (local.set $q4 (i32.load offset=16 (local.get $qp)))
      (local.set $q5 (i32.load offset=20 (local.get $qp)))
      (local.set $q6 (i32.load offset=24 (local.get $qp)))
      (local.set $q7 (i32.load offset=28 (local.get $qp)))
      ;; Only accepted results need exact top-2. Distances >=87 cannot change
      ;; acceptance for best<=64 and strict 4*best < 3*second.
      (local.set $best (i32.const 87)) (local.set $second (i32.const 87))
      (local.set $index (i32.const -1)) (local.set $j (i32.const 0)) (local.set $p (local.get $t))
      (block $trainsDone (loop $trains
        (br_if $trainsDone (i32.ge_u (local.get $j) (local.get $tn)))
        (block $next
          (local.set $d (i32.const 0))
          (local.set $d (i32.add (local.get $d) (i32.popcnt (i32.xor (local.get $q0) (i32.load offset=0 (local.get $p))))))
          (local.set $d (i32.add (local.get $d) (i32.popcnt (i32.xor (local.get $q1) (i32.load offset=4 (local.get $p))))))
          (br_if $next (i32.ge_u (local.get $d) (local.get $second)))
          (local.set $d (i32.add (local.get $d) (i32.popcnt (i32.xor (local.get $q2) (i32.load offset=8 (local.get $p))))))
          (local.set $d (i32.add (local.get $d) (i32.popcnt (i32.xor (local.get $q3) (i32.load offset=12 (local.get $p))))))
          (br_if $next (i32.ge_u (local.get $d) (local.get $second)))
          (local.set $d (i32.add (local.get $d) (i32.popcnt (i32.xor (local.get $q4) (i32.load offset=16 (local.get $p))))))
          (local.set $d (i32.add (local.get $d) (i32.popcnt (i32.xor (local.get $q5) (i32.load offset=20 (local.get $p))))))
          (br_if $next (i32.ge_u (local.get $d) (local.get $second)))
          (local.set $d (i32.add (local.get $d) (i32.popcnt (i32.xor (local.get $q6) (i32.load offset=24 (local.get $p))))))
          (local.set $d (i32.add (local.get $d) (i32.popcnt (i32.xor (local.get $q7) (i32.load offset=28 (local.get $p))))))
          (br_if $next (i32.ge_u (local.get $d) (local.get $second)))
          (if (i32.lt_u (local.get $d) (local.get $best))
            (then (local.set $second (local.get $best)) (local.set $best (local.get $d)) (local.set $index (local.get $j)))
            (else (if (i32.lt_u (local.get $d) (local.get $second)) (then (local.set $second (local.get $d))))))
        )
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (local.set $p (i32.add (local.get $p) (i32.const 32))) (br $trains)))
      (local.set $op (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 3))))
      (i32.store (local.get $op) (if (result i32)
        (i32.and (i32.le_u (local.get $best) (i32.const 64)) (i32.lt_u (i32.shl (local.get $best) (i32.const 2)) (i32.mul (local.get $second) (i32.const 3))))
        (then (local.get $index)) (else (i32.const -1))))
      (i32.store offset=4 (local.get $op) (local.get $best))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $queries)))
  )
)
